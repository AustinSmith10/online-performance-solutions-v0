{
  "name": "online-performance-solution",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "worker": "tsx --tsconfig tsconfig.worker.json worker.ts",
    "db:generate": "npx supabase gen types typescript --local > types/supabase.ts",
    "seed": "node --env-file=.env.local ./node_modules/.bin/tsx supabase/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:concurrency": "vitest run --config vitest.concurrency.config.ts",
    "uat:snapshot": "node --env-file=.env.local scripts/uat/snapshot.mjs",
    "uat:reset": "node --env-file=.env.local scripts/uat/reset.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@sentry/nextjs": "^10.70.0",
    "@sentry/node": "^10.70.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "docxtemplater": "^3.68.7",
    "next": "16.3.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "pg-boss": "^12.18.2",
    "pino": "^10.3.1",
    "pizzip": "^3.2.0",
    "postmark": "^5.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "playwright": "^1.61.0",
    "railway": "^3.4.1",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
